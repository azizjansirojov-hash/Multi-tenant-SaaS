// SYZX — core multi-tenant data model

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum Plan {
  FREE
  PRO
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum NotificationType {
  INVITE
  CARD_ASSIGNED
  CARD_COMMENTED
  DUE_DATE_SOON
}

/// Presign creates PENDING; confirmAttachment promotes to CONFIRMED.
/// Abandoned PENDING rows are cleaned after ATTACHMENT_PENDING_TTL_HOURS.
enum AttachmentStatus {
  PENDING
  CONFIRMED
}

enum ActivityAction {
  CREATED
  UPDATED
  DELETED
  MOVED
  COMMENTED
  ATTACHED
  INVITED
  ROLE_CHANGED
  MEMBER_REMOVED
}

enum ActivityEntityType {
  ORGANIZATION
  PROJECT
  BOARD
  COLUMN
  CARD
  COMMENT
  ATTACHMENT
  MEMBERSHIP
  INVITATION
}

model Organization {
  id                 String             @id @default(cuid())
  name               String
  slug               String             @unique
  stripeCustomerId   String?            @unique
  subscriptionStatus SubscriptionStatus @default(INCOMPLETE)
  plan               Plan               @default(FREE)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  memberships   Membership[]
  projects      Project[]
  invitations   Invitation[]
  notifications Notification[]
  activityLogs  ActivityLog[]
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  passwordHash   String?
  name           String?
  image          String?
  /// Bumped on password change / membership removal to invalidate JWTs
  sessionVersion Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  memberships   Membership[]
  assignedCards Card[]         @relation("CardAssignee")
  comments      Comment[]
  notifications Notification[]
  attachments   Attachment[]
  activityLogs  ActivityLog[]  @relation("ActivityActor")
}

model Membership {
  id             String   @id @default(cuid())
  userId         String
  organizationId String
  role           Role     @default(MEMBER)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
}

model Project {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  description    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  boards       Board[]

  @@index([organizationId])
}

model Board {
  id        String   @id @default(cuid())
  projectId String
  name      String
  position  Float    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  columns Column[]

  @@index([projectId])
}

model Column {
  id        String   @id @default(cuid())
  boardId   String
  name      String
  position  Float    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  board Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  cards Card[]

  @@index([boardId])
}

model Card {
  id          String    @id @default(cuid())
  columnId    String
  title       String
  description String?
  position    Float     @default(0)
  assigneeId  String?
  dueDate     DateTime?
  priority    Priority  @default(MEDIUM)
  labels      String[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  column      Column       @relation(fields: [columnId], references: [id], onDelete: Cascade)
  assignee    User?        @relation("CardAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  comments    Comment[]
  attachments Attachment[]

  @@index([columnId])
  @@index([assigneeId])
}

/// Card-scoped comments (polymorphic-safe: FK to Card only, not a free-form polymorphic table)
model Comment {
  id        String    @id @default(cuid())
  cardId    String
  authorId  String
  body      String
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  card   Card @relation(fields: [cardId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([cardId])
  @@index([authorId])
}

model Notification {
  id             String           @id @default(cuid())
  userId         String
  organizationId String
  type           NotificationType
  payload        Json
  readAt         DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([organizationId])
}

/// File metadata only — blobs live in S3-compatible object storage.
/// Lifecycle: createAttachmentUpload writes PENDING + storage key at presign;
/// confirmAttachment sets CONFIRMED after the client PUT succeeds.
/// Opportunistic cleanup deletes PENDING older than ATTACHMENT_PENDING_TTL_HOURS
/// (DB row + storage object) so abandoned uploads do not orphan metadata forever.
model Attachment {
  id         String           @id @default(cuid())
  cardId     String
  uploaderId String
  fileName   String
  mimeType   String
  sizeBytes  Int
  storageKey String
  status     AttachmentStatus @default(PENDING)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  card     Card @relation(fields: [cardId], references: [id], onDelete: Cascade)
  uploader User @relation(fields: [uploaderId], references: [id], onDelete: Cascade)

  @@index([cardId])
  @@index([uploaderId])
  @@index([status, createdAt])
}

/// Append-only tenant activity trail (no updates/deletes in application code)
model ActivityLog {
  id             String             @id @default(cuid())
  organizationId String
  actorId        String?
  action         ActivityAction
  entityType     ActivityEntityType
  entityId       String
  summary        String
  metadata       Json?
  createdAt      DateTime           @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor        User?        @relation("ActivityActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([organizationId, createdAt])
}

model Invitation {
  id             String    @id @default(cuid())
  organizationId String
  email          String
  role           Role      @default(MEMBER)
  token          String    @unique
  expiresAt      DateTime
  /// Set when the invitation is successfully accepted (consumed)
  acceptedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
}

/// Stripe webhook idempotency — stores processed event IDs
model ProcessedStripeEvent {
  id        String   @id // Stripe event id (evt_...)
  type      String
  createdAt DateTime @default(now())
}

/// Fixed-window rate-limit counters (shared across serverless instances)
model RateLimitBucket {
  id          String   @id @default(cuid())
  key         String
  windowStart DateTime
  count       Int      @default(0)
  updatedAt   DateTime @updatedAt

  @@unique([key, windowStart])
  @@index([key])
}
