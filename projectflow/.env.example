# SYZX local / deployment environment variables (names only — set real values in .env)

# PostgreSQL connection (local Docker Compose example below).
# PRODUCTION: do NOT use a superuser or table-owner role. Use syzx_app
# (NOSUPERUSER, NOBYPASSRLS). Superuser connections silently bypass FORCE RLS.
# Local docker user syzx_dev is a superuser; the app SET LOCAL ROLE syzx_app
# on every checkout. Misconfiguration throws RlsPrivilegeError at runtime.
DATABASE_URL="postgresql://syzx_dev:syzx_dev_password@localhost:5432/syzx_dev"

# Auth.js v5
AUTH_SECRET=
# CRITICAL: Browser cookies are scoped to the exact host. Use ONE origin consistently.
# Next.js prints both Local (http://localhost:3000) and Network (e.g. http://172.24.32.1:3000).
# Logging in on one host then opening the other looks like "logged out after restart" —
# it is a different cookie jar, not an expired session. Set AUTH_URL to the host you actually open.
AUTH_URL="http://localhost:3000"
# Mandatory in production (true or false). Unset/invalid in production is a
# startup error. When true, Auth.js trusts X-Forwarded-Host / X-Forwarded-Proto
# from the reverse proxy. Set true behind a proxy that overwrites those headers;
# set false if AUTH_URL is the canonical origin and nothing sits in front.
AUTH_TRUST_HOST=true

# Number of trusted reverse proxies that overwrite X-Forwarded-For.
# Default 0: ignore X-Forwarded-For / X-Real-IP (client cannot spoof rate-limit keys).
# Single nginx/Caddy/load balancer in front of Node → 1.
# The app walks X-Forwarded-For from the right and skips this many hops.
TRUSTED_PROXY_COUNT=0

# Stripe billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=

# Resend (invitation email)
RESEND_API_KEY=
RESEND_FROM_EMAIL="SYZX <onboarding@resend.dev>"

# S3-compatible object storage (MinIO local example; leave unset to use in-memory mock)
S3_ENDPOINT="http://127.0.0.1:9000"
S3_REGION="us-east-1"
S3_BUCKET="syzx-attachments"
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# SSE realtime caps (per Node process / instance)
# Shared LISTEN uses 1 dedicated pg connection; publish pool uses up to 4.
MAX_SSE_CONNECTIONS=200
MAX_SSE_CONNECTIONS_PER_ORG=40
# Optional: abandoned PENDING attachment TTL (hours) for opportunistic cleanup
ATTACHMENT_PENDING_TTL_HOURS=24
